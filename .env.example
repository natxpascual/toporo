# ── 1. JWT & Session Security ────────────────────────────────────────────────
JWT_SECRET_KEY="replace-with-strong-64-char-random-hex"
JWT_ACCESS_EXPIRE_MINUTES=10080       # 7 days (standard login with Remember Me)
JWT_ELEVATED_EXPIRE_MINUTES=30        # 30 minutes (for /login?session=elevate -> /manage)

# ── 2. Seeded Admin Account (Auto-provisioned on Server Startup) ────────────
ADMIN_EMAIL="admin@toporo.dev"
ADMIN_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="ChangeMeImmediately!2026"
ADMIN_FULL_NAME="Toporo Platform Administrator"

# ── 3. Storage: Azure Table Storage (with automatic local fallback) ─────────
# Uses existing fn_storage from deploy/main.tf in production; falls back to
# local data/toporo_users.json if AZURE_STORAGE_CONNECTION_STRING is empty.
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_USERS_TABLE_NAME="ToporoUsers"

# ── 4. Email OTP Delivery (Resend HTTP API) ──────────────────────────────────
# Free tier: 3,000 emails/mo. If empty in local dev, 6-digit OTPs are printed
# to the backend console for effortless testing.
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="Toporo Security <no-reply@toporo.dev>"

# ── 5. OAuth 2.0 SSO Credentials (Google & GitHub) ──────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/auth/oauth/google/callback"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:8000/api/auth/oauth/github/callback"

# Frontend base URL for OAuth callback redirects
FRONTEND_BASE_URL="http://localhost:3000"

